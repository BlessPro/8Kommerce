# Compose and release
COMPOSE_PROJECT_NAME=8kommerce
APP_IMAGE=ghcr.io/blesspro/8kommerce@sha256:replace-with-verified-digest
CADDYFILE=./Caddyfile.prelaunch

# Public addresses
PRIMARY_DOMAIN=8kommerce.com
APP_DOMAIN=app.8kommerce.com
STATUS_DOMAIN=status.8kommerce.com
ACME_EMAIL=operations@8kommerce.com

# Laravel
APP_NAME=8Kommerce
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.8kommerce.com
APP_VERSION=0.1.0
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
FILESYSTEM_DISK=local
TRUSTED_PROXIES=*

# Database and Redis: generate unique random values before deployment.
DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=8kommerce
DB_USERNAME=8kommerce
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_WORKER_REPLICAS=2
OTP_WORKER_REPLICAS=1
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# Authentication
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_LENGTH=6
OTP_QUEUE_CONNECTION=redis
PIN_MAX_LOGIN_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900
PIN_ENFORCE_WEAK_DENYLIST=true
PIN_WEAK_VALUES=0000,1111,1234,2222,3333,4444,5555,6789,7777,8888,9876,9999

# Email: configure a real SMTP provider before relying on email alerts/admin OTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=operations@8kommerce.com
MAIL_FROM_NAME=8Kommerce

# Payments
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://app.8kommerce.com/pay/success
PAYSTACK_CURRENCY=GHS
PLATFORM_FEE_FLAT=0
PAYSTACK_SUBACCOUNT_PERCENT_CHARGE=0
BILLING_MANUAL_ACTIVATION_ENABLED=false
BILLING_PROVIDER=paystack
BILLING_RECURRING_ENABLED=false
BILLING_MANUAL_RENEWAL_ENABLED=true
BILLING_MANUAL_PERIOD_DAYS=30
BILLING_GRACE_DAYS=3
BILLING_CALLBACK_URL=https://app.8kommerce.com/billing/callback
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_ENTERPRISE=

# SMS
SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_BASE_URL=https://smsc.hubtel.com/v1/messages/send
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_DEFAULT_COUNTRY=+233
TWILIO_STATUS_CALLBACK_URL=https://app.8kommerce.com/webhooks/twilio/status

# Orders and administration
ORDER_DISPUTE_REFUND_PERCENT=0.90
ORDER_SUPPORT_PHONE=
ORDER_SELLER_RESPONSE_HOURS=24
ORDER_INVENTORY_RESERVATION_MINUTES=30
ORDER_LEGACY_REFERENCE_TRACKING_ENABLED=false
ADMIN_ALLOWED_EMAILS=

# Operations
MONITORING_QUEUE_NAMES=otp,payments,notifications,default
MONITORING_QUEUE_MAX_DEPTH=100
MONITORING_QUEUE_ALERT_COOLDOWN=300
SECURITY_WEBHOOK_RETENTION_DAYS=180
SECURITY_MESSAGE_LOG_RETENTION_DAYS=90
SECURITY_ANALYTICS_RETENTION_DAYS=365
STATUS_INCIDENT_ACTIVE=false
STATUS_INCIDENT_SEVERITY=maintenance
STATUS_INCIDENT_TITLE=
STATUS_INCIDENT_MESSAGE=
STATUS_INCIDENT_UPDATED_AT=

VITE_APP_NAME=8Kommerce
